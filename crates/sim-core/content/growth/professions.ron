// Professions: who a people's residents can become, and where they work.
(domain: Professions, nodes: [
    (id: "builders", name: "Builders", tier: 1, requires: ["shelters"], unlocks: [
        (id: "builder", name: "Builder", kind: Job, effects: [Speed(0.2)], look: "builder"),
    ]),
    (id: "toolmakers", name: "Toolmakers", tier: 1, requires: ["knapping"], unlocks: [
        (id: "toolmaker", name: "Toolmaker", kind: Job, effects: [Speed(0.1)], look: "toolmaker"),
    ]),
    (id: "warriors", name: "Warriors", tier: 2, requires: ["spears"], spurs: [Raided, War, Monsters], unlocks: [
        (id: "warrior", name: "Warrior", kind: Job, effects: [Attack(1.5)], look: "warrior"),
        (id: "guard", name: "Guard", kind: Job, effects: [Defense(0.2), Vision(6)], look: "guard"),
        (id: "war_camp", name: "War camp", kind: Building, cost: [("wood", 12)], work: 6, footprint: (2, 2), effects: [Capacity(10), Morale(0.05)], look: "war_camp"),
    ]),
    (id: "beast_taming", name: "Beast taming", tier: 4, requires: ["hunting"], any_of: ["goat_herding", "sheep_herding", "reindeer_herding", "cattle_herding", "camel_herding"],
     spurs: [Monsters], unlocks: [
        (id: "beast_tamer", name: "Beast tamer", kind: Job, effects: [Morale(0.05)], look: "beast_tamer"),
        (id: "beast_pen", name: "Beast pen", kind: Building, cost: [("wood", 16), ("rope", 4)], work: 10, footprint: (2, 2),
         effects: [Capacity(4), Defense(0.2)], look: "beast_pen",
         variants: [(when: [Mountain, Hills], name: "Beast cave", look: "beast_cave", cost: [("stone", 12)])]),
        (id: "war_dogs", name: "War dogs", kind: Job, conditions: [Building("beast_pen")], effects: [Attack(2), Speed(0.3)], look: "war_dogs"),
        (id: "guardian_lair", name: "Guardian lair", kind: Building, cost: [("stone", 20), ("meat", 10)], work: 20, footprint: (2, 2),
         conditions: [Building("beast_pen"), Trial(Monsters)], effects: [Defense(1.0), Attack(8)], look: "guardian_lair"),
    ]),
    (id: "merchants", name: "Merchants", tier: 3, requires: ["bartering"], spurs: [Trade], unlocks: [
        (id: "merchant", name: "Merchant", kind: Job, effects: [Trade(0.3)], look: "merchant"),
        (id: "market", name: "Market", kind: Building, cost: [("wood", 20)], work: 12, footprint: (3, 3), effects: [Trade(0.5), Morale(0.05)], look: "market",
         variants: [
            (when: [Biome(Desert)], name: "Bazaar", look: "bazaar", cost: [("cloth", 6), ("wood", 8)]),
            (when: [River, Lake], name: "Floating market", look: "floating_market", cost: [("wood", 24)]),
         ]),
    ]),
    (id: "smithing", name: "Smithing", tier: 4, requires: ["copper_smelting"], unlocks: [
        (id: "smith", name: "Smith", kind: Job, effects: [Speed(0.2)], look: "smith"),
        (id: "smithy", name: "Smithy", kind: Building, cost: [("stone", 16), ("wood", 10)], work: 12, footprint: (2, 2), effects: [Speed(0.2)], look: "smithy"),
    ]),
    (id: "scribes", name: "Scribes", tier: 5, requires: ["writing"], unlocks: [
        (id: "scribe", name: "Scribe", kind: Job, effects: [Research(0.2)], look: "scribe"),
        (id: "archive", name: "Archive", kind: Building, cost: [("stone", 20), ("wood", 10)], work: 20, footprint: (2, 2), effects: [Research(0.2), Storage(20)], look: "archive"),
    ]),
    (id: "cavalry", name: "Cavalry", tier: 6, requires: ["horse_riding"], spurs: [War, Raided], unlocks: [
        (id: "rider", name: "Rider", kind: Job, effects: [Attack(3), Speed(0.6)], look: "rider",
         variants: [(when: [Biome(Desert)], name: "Camel rider", look: "camel_rider")]),
        (id: "stable", name: "Stable", kind: Building, cost: [("wood", 20)], work: 10, footprint: (3, 2), effects: [Capacity(8)], look: "stable"),
    ]),
    (id: "professional_army", name: "Professional army", tier: 7, requires: ["iron_weapons", "law_codes"], spurs: [War, Siege], unlocks: [
        (id: "soldier", name: "Soldier", kind: Job, effects: [Attack(4), Defense(0.3)], look: "soldier"),
        (id: "barracks", name: "Barracks", kind: Building, cost: [("stone", 40), ("wood", 20)], work: 30, footprint: (3, 2),
         effects: [Capacity(20), Morale(0.05)], look: "barracks"),
        (id: "drill", name: "Drill", kind: Law, effects: [Attack(1), Loyalty(0.05)], look: "drill"),
    ]),
    (id: "engineers", name: "Engineers", tier: 7, requires: ["siege_engines", "mathematics"], unlocks: [
        (id: "engineer", name: "Engineer", kind: Job, effects: [Speed(0.3), Research(0.1)], look: "engineer"),
    ]),
    (id: "scholars", name: "Scholars", tier: 7, requires: ["scribes", "mathematics"], unlocks: [
        (id: "scholar", name: "Scholar", kind: Job, effects: [Research(0.4)], look: "scholar"),
        (id: "academy", name: "Academy", kind: Building, cost: [("stone", 60), ("marble", 6)], work: 50, footprint: (3, 3),
         conditions: [Population(150)], effects: [Research(0.5)], look: "academy"),
    ]),
    (id: "machinists", name: "Machinists", tier: 9, requires: ["steam_power"], unlocks: [
        (id: "machinist", name: "Machinist", kind: Job, effects: [Speed(0.4)], look: "machinist"),
    ]),
    (id: "scientists", name: "Scientists", tier: 10, requires: ["scholars", "electricity"], unlocks: [
        (id: "scientist", name: "Scientist", kind: Job, effects: [Research(0.6)], look: "scientist"),
        (id: "laboratory", name: "Laboratory", kind: Building, cost: [("concrete", 40), ("glass", 20), ("wire", 10)], work: 50, footprint: (2, 2),
         consumes: [("electricity", 1)], effects: [Research(1.0)], look: "laboratory"),
    ]),
])
