        (id: "machine_shop", name: "Machine shop", kind: Building, cost: [("steel", 20), ("brick", 30)], work: 40, footprint: (2, 3),
         conditions: [Building("steam_engine")], effects: [Speed(0.3)], look: "machine_shop"),
        (id: "machining", name: "Machining", kind: Process, consumes: [("steel", 2), ("coal", 1)], produces: [("machine_parts", 2)], work: 3,
         conditions: [Building("machine_shop")]),
    ]),
    (id: "vulcanisation", name: "Vulcanised rubber", tier: 9, requires: ["steam_power"], needs: ["latex", "sulfur"], unlocks: [
        (id: "rubber_curing", name: "Rubber curing", kind: Process, consumes: [("latex", 2), ("sulfur", 1)], produces: [("rubber", 2)], work: 2),
    ]),
    (id: "oil_refining", name: "Oil refining", tier: 9, requires: ["steam_power"], needs: ["crude_oil"], unlocks: [
        (id: "refinery", name: "Refinery", kind: Building, cost: [("steel", 40), ("machine_parts", 10), ("brick", 30)], work: 60, footprint: (3, 3),
         look: "refinery"),
        (id: "distil_oil", name: "Oil distillation", kind: Process, consumes: [("crude_oil", 3)], produces: [("fuel", 2)], work: 2,
         conditions: [Building("refinery")]),
    ]),
    (id: "electricity", name: "Electricity", tier: 9, requires: ["steam_power", "copper_smelting"], era: "electric", effort: 3.0, unlocks: [
        (id: "wire_drawing", name: "Wire drawing", kind: Process, consumes: [("copper", 2)], produces: [("wire", 3)], work: 2),
        (id: "generator", name: "Coal generator", kind: Building, cost: [("steel", 30), ("wire", 20), ("machine_parts", 10)], work: 50, footprint: (2, 2),
         consumes: [("coal", 2)], produces: [("electricity", 4)], look: "generator"),
        (id: "water_turbine", name: "Water turbine", kind: Building, cost: [("steel", 20), ("wire", 20), ("concrete", 30)], work: 60, footprint: (2, 2),
         conditions: [Place([River])], produces: [("electricity", 3)], look: "water_turbine"),
    ]),
])
