        (id: "bronze_alloy", name: "Bronze alloy", kind: Process, consumes: [("copper", 3), ("tin_ore", 1), ("charcoal", 1)], produces: [("bronze", 4)], work: 3,
         conditions: [Building("foundry")]),
        (id: "foundry", name: "Foundry", kind: Building, cost: [("brick", 20), ("stone", 10)], work: 14, footprint: (2, 2),
         effects: [Speed(0.2)], look: "foundry"),
    ]),
    (id: "glassmaking", name: "Glassmaking", tier: 4, requires: ["lime_burning", "pottery"], needs: ["sand"], unlocks: [
        (id: "glass_melt", name: "Glass melting", kind: Process, consumes: [("sand", 3), ("lime", 1), ("charcoal", 1)], produces: [("glass", 2)], work: 3),
        (id: "glass_beads", name: "Glass beads", kind: Tool, cost: [("glass", 1)], work: 1, effects: [Trade(0.1), Morale(0.02)], look: "beads"),
    ]),
    (id: "iron_smelting", name: "Iron smelting", tier: 5, requires: ["copper_smelting"], needs: ["iron_ore"],
     era: "iron-forging", effort: 2.0, spurs: [War], unlocks: [
        (id: "bloomery", name: "Bloomery", kind: Building, cost: [("clay", 16), ("stone", 12)], work: 12, footprint: (1, 1),
         effects: [Speed(0.1)], look: "bloomery"),
        (id: "iron_bloom", name: "Iron bloom", kind: Process, consumes: [("iron_ore", 3), ("charcoal", 3)], produces: [("iron", 1)], work: 4,
         conditions: [Building("bloomery")]),
    ]),
    (id: "papermaking", name: "Papermaking", tier: 5, requires: ["weaving", "writing"], unlocks: [
        (id: "papyrus", name: "Papyrus", kind: Process, consumes: [("reed", 4)], produces: [("paper", 2)], work: 2,
         conditions: [Place([River, Biome(Swamp)])]),
        (id: "pulp_paper", name: "Pulp paper", kind: Process, consumes: [("wood", 3), ("lime", 1)], produces: [("paper", 2)], work: 3),
        (id: "rag_paper", name: "Rag paper", kind: Process, consumes: [("cloth", 1)], produces: [("paper", 2)], work: 2),
    ]),
    (id: "steelmaking", name: "Steelmaking", tier: 6, requires: ["iron_smelting"], era: "steel-forging", effort: 2.0, spurs: [War, Siege], unlocks: [
        (id: "crucible_steel", name: "Crucible steel", kind: Process, consumes: [("iron", 2), ("charcoal", 2), ("pottery", 1)], produces: [("steel", 1)], work: 5),
        (id: "forge", name: "Great forge", kind: Building, cost: [("brick", 30), ("iron", 6)], work: 20, footprint: (2, 2),
         effects: [Speed(0.3)], look: "great_forge"),
    ]),
    (id: "concrete", name: "Concrete", tier: 6, requires: ["lime_burning", "masonry"], needs: ["sand"], unlocks: [
        (id: "concrete_mix", name: "Concrete mixing", kind: Process, consumes: [("lime", 2), ("sand", 2), ("stone", 2)], produces: [("concrete", 4)], work: 3),
    ]),
    (id: "blast_furnace", name: "Coke and the blast furnace", tier: 7, requires: ["steelmaking"], needs: ["coal"], effort: 2.0, unlocks: [
        (id: "coking", name: "Coking", kind: Process, consumes: [("coal", 3)], produces: [("coke", 2)], work: 2),
        (id: "blast_furnace_works", name: "Blast furnace", kind: Building, cost: [("brick", 60), ("iron", 20), ("stone", 30)], work: 60, footprint: (2, 3),
         effects: [Speed(0.5)], look: "blast_furnace"),
        (id: "pig_iron", name: "Pig iron", kind: Process, consumes: [("iron_ore", 3), ("coke", 2), ("lime", 1)], produces: [("iron", 3)], work: 2,
         conditions: [Building("blast_furnace_works")]),
        (id: "bulk_steel", name: "Bulk steel", kind: Process, consumes: [("iron", 3), ("coke", 1)], produces: [("steel", 2)], work: 2,
         conditions: [Building("blast_furnace_works")]),
    ]),
    (id: "gunpowder", name: "Gunpowder", tier: 7, requires: ["charcoal_burning", "alchemy"], needs: ["saltpeter", "sulfur"],
     era: "gunpowder", effort: 2.0, spurs: [War, Siege], unlocks: [
        (id: "powder_mill", name: "Powder mill", kind: Building, cost: [("wood", 30), ("stone", 20)], work: 20, footprint: (2, 2),
         effects: [Speed(0.2)], look: "powder_mill"),
        (id: "black_powder", name: "Black powder", kind: Process, consumes: [("saltpeter", 3), ("sulfur", 1), ("charcoal", 1)], produces: [("gunpowder", 3)], work: 2,
         conditions: [Building("powder_mill")]),
        (id: "fireworks", name: "Fireworks", kind: Tool, cost: [("gunpowder", 1), ("paper", 1)], work: 1, effects: [Morale(0.15)], look: "fireworks"),
    ]),
    (id: "steam_power", name: "Steam power", tier: 8, requires: ["blast_furnace"], needs: ["coal"], era: "steam", effort: 2.5, unlocks: [
        (id: "steam_engine", name: "Steam engine", kind: Building, cost: [("iron", 30), ("steel", 10), ("brick", 20)], work: 40, footprint: (2, 2),
