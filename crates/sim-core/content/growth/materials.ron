// Materials and processing: fire to electricity. Processes turn accessible
// inputs into new resources; that is how a region without an ore can still
// work its metal once the ore or the metal arrives by trade.
(domain: Materials, nodes: [
    (id: "fire", name: "Fire", tier: 0, starting: true, era: "stone-using", unlocks: [
        (id: "campfire", name: "Campfire", kind: Building, cost: [("wood", 3)], work: 1, footprint: (1, 1),
         effects: [Morale(0.05), Healing(0.02)], look: "campfire",
         variants: [
            (when: [Biome(Tundra), Biome(Ice), Biome(Snowcap)], name: "Peat hearth", look: "peat_hearth", cost: [("peat", 3)]),
            (when: [Biome(Desert)], name: "Dung fire", look: "dung_fire", cost: []),
         ]),
    ]),
    (id: "cordage", name: "Cordage", tier: 1, requires: ["knapping"], unlocks: [
        (id: "fibre_rope", name: "Fibre rope", kind: Process, consumes: [("wild_fiber", 3)], produces: [("rope", 1)], work: 1),
        (id: "reed_rope", name: "Reed rope", kind: Process, consumes: [("reed", 3)], produces: [("rope", 1)], work: 1),
        (id: "bark_rope", name: "Bark rope", kind: Process, consumes: [("wood", 4)], produces: [("rope", 1)], work: 2),
        (id: "sinew_cord", name: "Sinew cord", kind: Process, consumes: [("bone", 2), ("hide", 1)], produces: [("rope", 1)], work: 2),
    ]),
    (id: "hide_working", name: "Hide working", tier: 1, requires: ["hunting"], needs: ["hide"], spurs: [Cold], unlocks: [
        (id: "tanning", name: "Tanning", kind: Process, consumes: [("hide", 2)], produces: [("leather", 1)], work: 2),
        (id: "tanning_rack", name: "Tanning rack", kind: Building, cost: [("wood", 4)], work: 2, footprint: (1, 1),
         effects: [Speed(0.1)], look: "tanning_rack",
         variants: [(when: [Biome(Tundra), Biome(Ice)], name: "Bone drying frame", look: "bone_frame", cost: [("bone", 6)])]),
    ]),
    (id: "pottery", name: "Pottery", tier: 1, requires: ["fire"], needs: ["clay"], unlocks: [
        (id: "pit_firing", name: "Pit firing", kind: Process, consumes: [("clay", 2), ("wood", 1)], produces: [("pottery", 2)], work: 2),
        (id: "kiln", name: "Kiln", kind: Building, cost: [("clay", 10), ("stone", 4)], work: 6, footprint: (1, 1),
         effects: [Speed(0.2)], look: "kiln",
         variants: [(when: [Biome(Swamp), Biome(Rainforest), River], name: "Clay dome kiln", look: "dome_kiln", cost: [("clay", 16)])]),
    ]),
    (id: "charcoal_burning", name: "Charcoal burning", tier: 2, requires: ["fire"], needs: ["wood"], unlocks: [
        (id: "charcoal_clamp", name: "Charcoal clamp", kind: Process, consumes: [("wood", 4)], produces: [("charcoal", 2)], work: 3),
        (id: "peat_charring", name: "Peat charring", kind: Process, consumes: [("peat", 4)], produces: [("charcoal", 1)], work: 3),
    ]),
    (id: "weaving", name: "Weaving", tier: 2, requires: ["cordage"], unlocks: [
        (id: "fibre_cloth", name: "Plant-fibre cloth", kind: Process, consumes: [("wild_fiber", 4)], produces: [("cloth", 1)], work: 3),
        (id: "wool_cloth", name: "Woollen cloth", kind: Process, consumes: [("wool", 2)], produces: [("cloth", 2)], work: 2),
        (id: "cotton_cloth", name: "Cotton cloth", kind: Process, consumes: [("cotton", 2)], produces: [("cloth", 2)], work: 2),
        (id: "bark_cloth", name: "Bark cloth", kind: Process, consumes: [("wood", 3)], produces: [("cloth", 1)], work: 4,
         conditions: [Place([Biome(Rainforest), Biome(Savanna)])]),
        (id: "loom", name: "Loom", kind: Building, cost: [("wood", 8), ("rope", 2)], work: 4, footprint: (1, 1),
         effects: [Speed(0.2)], look: "loom"),
    ]),
    (id: "brickmaking", name: "Brickmaking", tier: 2, requires: ["pottery"], unlocks: [
        (id: "fired_brick", name: "Fired brick", kind: Process, consumes: [("clay", 3), ("wood", 1)], produces: [("brick", 3)], work: 2),
        (id: "sun_dried_brick", name: "Sun-dried mud brick", kind: Process, consumes: [("clay", 3)], produces: [("brick", 2)], work: 3,
         conditions: [Place([Biome(Desert), Biome(Savanna), Biome(ColdSteppe)])]),
    ]),
    (id: "lime_burning", name: "Lime burning", tier: 2, requires: ["fire"], needs: ["limestone"], unlocks: [
        (id: "lime_kiln", name: "Lime kiln", kind: Process, consumes: [("limestone", 3), ("wood", 2)], produces: [("lime", 2)], work: 3),
        (id: "shell_lime", name: "Shell lime", kind: Process, consumes: [("shellfish", 4), ("wood", 1)], produces: [("lime", 1)], work: 3),
    ]),
    (id: "tar_making", name: "Tar making", tier: 3, requires: ["charcoal_burning"], local: [Biome(Taiga), Biome(TemperateForest)], unlocks: [
        (id: "tar_pit", name: "Tar pit", kind: Process, consumes: [("wood", 5)], produces: [("tar", 1)], work: 3),
    ]),
    (id: "copper_smelting", name: "Copper smelting", tier: 3, requires: ["pottery", "charcoal_burning"], needs: ["copper_ore"],
     era: "copper-working", effort: 1.5, unlocks: [
        (id: "copper_smelt", name: "Copper smelting", kind: Process, consumes: [("copper_ore", 3), ("charcoal", 2)], produces: [("copper", 1)], work: 3,
         conditions: [Building("smelter")]),
        (id: "smelter", name: "Smelter", kind: Building, cost: [("clay", 12), ("stone", 8)], work: 8, footprint: (1, 1),
         effects: [Speed(0.1)], look: "smelter"),
    ]),
    (id: "precious_metals", name: "Precious metals", tier: 4, requires: ["copper_smelting"], spurs: [Trade], unlocks: [
        (id: "gold_refining", name: "Gold refining", kind: Process, consumes: [("gold_ore", 3), ("charcoal", 1)], produces: [("gold", 1)], work: 3),
        (id: "silver_refining", name: "Silver refining", kind: Process, consumes: [("silver_ore", 3), ("charcoal", 1)], produces: [("silver", 1)], work: 3),
        (id: "jewellery", name: "Jewellery", kind: Tool, cost: [("gold", 1)], work: 3, effects: [Morale(0.05), Trade(0.1)], look: "jewellery",
         variants: [(when: [Coast], name: "Pearl jewellery", look: "pearl_jewellery", cost: [("pearls", 2), ("silver", 1)])]),
    ]),
    (id: "bronze_alloying", name: "Bronze alloying", tier: 4, requires: ["copper_smelting"], needs: ["copper_ore", "tin_ore"],
