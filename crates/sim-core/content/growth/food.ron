         effects: [FoodYield(0.15)], look: "hunter"),
        (id: "shore_gathering", name: "Shore gathering", kind: Job, produces: [("meat", 1)], conditions: [Resource("shellfish")],
         effects: [FoodYield(0.1)], look: "shore_gatherer"),
    ]),
    (id: "cooking", name: "Cooking", tier: 1, requires: ["fire"], unlocks: [
        (id: "roast_meat", name: "Roast meat", kind: Dish, consumes: [("meat", 1)], effects: [Morale(0.05), Healing(0.02)], look: "roast"),
        (id: "fish_stew", name: "Fish stew", kind: Dish, consumes: [("fish", 2)], effects: [Morale(0.05)], look: "stew",
         variants: [(when: [Biome(Rainforest), Biome(Savanna)], name: "Pepper fish stew", look: "pepper_stew")]),
        (id: "earth_oven", name: "Earth oven", kind: Building, cost: [("stone", 4)], work: 2, footprint: (1, 1), effects: [FoodYield(0.05)], look: "earth_oven",
         variants: [(when: [Coast], name: "Clam bake pit", look: "clam_pit", cost: [])]),
    ]),
    (id: "preservation", name: "Food preservation", tier: 2, requires: ["cooking"], spurs: [Famine, Cold], unlocks: [
        (id: "salting", name: "Salting", kind: Process, consumes: [("fish", 2), ("salt", 1)], produces: [("preserved_food", 2)], work: 1),
        (id: "smoking", name: "Smoking", kind: Process, consumes: [("meat", 2), ("wood", 1)], produces: [("preserved_food", 2)], work: 2),
        (id: "freeze_drying", name: "Freeze drying", kind: Process, consumes: [("meat", 2)], produces: [("preserved_food", 2)], work: 2,
