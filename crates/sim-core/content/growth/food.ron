         effects: [FoodYield(0.5)], look: "grain_field",
         variants: [(when: [Biome(Desert)], name: "Oasis garden", look: "oasis_field")]),
        (id: "farmer", name: "Farmer", kind: Job, effects: [FoodYield(0.2)], look: "farmer"),
