        (id: "sun_drying", name: "Sun drying", kind: Process, consumes: [("fruit", 3)], produces: [("preserved_food", 2)], work: 1,
         conditions: [Place([Biome(Desert), Biome(Savanna)])]),
        (id: "smokehouse", name: "Smokehouse", kind: Building, cost: [("wood", 10)], work: 5, footprint: (1, 1), effects: [Storage(30)], look: "smokehouse"),
    ]),
    (id: "fishing", name: "Fishing", tier: 2, requires: ["cordage"], local: [Coast, River, Lake], needs: ["fish"], unlocks: [
        (id: "fisher", name: "Fisher", kind: Job, effects: [FoodYield(0.2)], look: "fisher"),
        (id: "fish_weir", name: "Fish weir", kind: Building, cost: [("wood", 8)], work: 5, footprint: (1, 2),
         conditions: [Place([River, Lake])], effects: [FoodYield(0.3)], look: "fish_weir",
         variants: [(when: [Biome(Swamp)], name: "Reed fish trap", look: "reed_trap", cost: [("reed", 8)])]),
        (id: "fishing_net", name: "Fishing net", kind: Tool, cost: [("rope", 3)], work: 2, effects: [FoodYield(0.1)], look: "net"),
    ]),
    (id: "agriculture", name: "Grain farming", tier: 2, requires: ["foraging"], needs: ["wild_grain"], era: "farming",
