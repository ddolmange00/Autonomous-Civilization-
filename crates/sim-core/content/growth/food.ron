// Food: foraging to refrigeration. Several independent domestications
// (grain, rice, tubers, herds) so each region reaches farming its own way.
(domain: Food, nodes: [
    (id: "foraging", name: "Foraging", tier: 0, starting: true, era: "stone-using", unlocks: [
        (id: "forager", name: "Forager", kind: Job, effects: [FoodYield(0.1)], look: "forager"),
        (id: "berry_gathering", name: "Berry gathering", kind: Process, produces: [("fruit", 1)], work: 1,
         conditions: [Resource("berries")]),
        (id: "honey_hunting", name: "Honey hunting", kind: Dish, consumes: [("honey", 1)], effects: [Morale(0.05)], look: "honeycomb"),
    ]),
    (id: "hunting", name: "Hunting", tier: 0, starting: true, unlocks: [
